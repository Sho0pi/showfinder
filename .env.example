SPOTIFY_CLIENT_ID=your_spotify_app_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_app_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:45678/callback
PORT=45678

# Optional. If Spotify blocks anonymous web-player tokens in your region,
# paste the sp_dc cookie value from an authenticated open.spotify.com browser session.
SPOTIFY_SP_DC=
